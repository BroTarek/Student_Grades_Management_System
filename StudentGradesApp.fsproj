<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Models.fs" />
    <Compile Include="State.fs" />
    <Compile Include="Views/Theme.fs" />
    <Compile Include="Views/RegistrationView.fs" />
    <Compile Include="Views/LoginView.fs" />
    <Compile Include="Views/ProfilePanel.fs" />
    <Compile Include="Views/ExamsTableView.fs" />
    <Compile Include="Views/StudentsTableView.fs" />
    <Compile Include="Views/StudentModals.fs" />
    <Compile Include="Views/MockSubmissionModal.fs" />
    <Compile Include="Views/HomeView.fs" />
    <Compile Include="Tests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.2.0" />
    <PackageReference Include="Avalonia.FuncUI" Version="2.0.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.2.0" />
  </ItemGroup>

</Project>
